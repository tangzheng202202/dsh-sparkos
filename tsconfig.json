{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../../cow/apps/dsh/vendor/cordis"],
      "@deepseek-ai/dsh-tools": ["../../cow/apps/dsh/packages/core/tools"],
      "@deepseek-ai/dsh-settings": ["../../cow/apps/dsh/packages/settings/settings"],
      "@deepseek-ai/dsh-credentials": ["../../cow/apps/dsh/packages/credentials/credentials"],
      "@deepseek-ai/dsh-attachment": ["../../cow/apps/dsh/packages/attachment/attachment"],
      "@deepseek-ai/dsh-host-webserver": ["../../cow/apps/dsh/packages/host/webserver"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
