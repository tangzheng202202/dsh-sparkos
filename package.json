{
  "name": "dsh-sparkos",
  "version": "0.2.0",
  "description": "DeepSeek Harness 自媒体工作台插件：星火库增量信源 + 叙事主线 + 选题/草稿/蒸馏审核工作流，五守卫硬执行（48h窗口/event_id去重/引用卡存在性/主线存在/建议只读），VAULT 数据与代码分离",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangzheng202202/dsh-sparkos.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/guards.test.ts tests/vault.test.ts tests/data.test.ts tests/intel.test.ts tests/daily.test.ts tests/routes.test.ts tests/storage.test.ts tests/ranking.test.ts tests/editorial.test.ts tests/creation.test.ts tests/factory.test.ts tests/visual.test.ts tests/visual-review.test.ts tests/visual-retry.test.ts tests/visual-ui.test.ts tests/v2-ui.test.ts tests/v2-retry-ui.test.ts tests/v2-creation-ui.test.ts",
    "test:dom": "node --experimental-strip-types scripts/render-page.mjs && python3 scripts/dom-check.py /tmp/sparkos-wb.html",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
