{
  "name": "dsh-sparkos",
  "version": "0.2.1",
  "description": "DeepSeek Harness 简报台：读每日简报和必读，采纳只记在本地账本，不自动发到社交平台。完整工厂管线默认关闭。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangzheng202202/dsh-sparkos.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": ">=0.0.1-rc.1 <0.0.2 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0 || >=0.2.4-0 <0.2.5-0 || >=0.2.5-0 <0.3.0-0",
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1 <0.0.2 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0 || >=0.2.4-0 <0.2.5-0 || >=0.2.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.0.2 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.2.4-0 || >=0.2.4-0 <0.2.5-0 || >=0.2.5-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p $(test -f tsconfig.local.json && echo tsconfig.local.json || echo tsconfig.json)",
    "test": "node --test --experimental-strip-types tests/guards.test.ts tests/vault.test.ts tests/data.test.ts tests/intel.test.ts tests/daily.test.ts tests/routes.test.ts tests/security.test.ts tests/semantics.test.ts tests/integrity.test.ts tests/storage.test.ts tests/ranking.test.ts tests/editorial.test.ts tests/creation.test.ts tests/factory.test.ts tests/visual.test.ts tests/visual-review.test.ts tests/visual-retry.test.ts tests/e2e-flow.test.ts tests/publish.test.ts tests/visual-ui.test.ts tests/v2-ui.test.ts tests/v2-retry-ui.test.ts tests/v2-creation-ui.test.ts tests/v2-delivery-ui.test.ts tests/v2-publish-ui.test.ts tests/unified-ui.test.ts tests/briefing.test.ts tests/mediaos.test.ts tests/digest.test.ts",
    "test:dom": "node --experimental-strip-types scripts/render-page.mjs && python3 scripts/dom-check.py",
    "prepack": "npm run build",
    "test:brief": "node --experimental-strip-types tests/briefing.test.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
