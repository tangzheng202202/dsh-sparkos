<?xml version="1.0" encoding="UTF-8"?>
<!--
  SparkOS 情报簇分析 · launchd 定时（模板）

  安装：bash launch/install-intel-analysis.sh
  卸载：launchctl bootout gui/$(id -u)/com.sparkos.intel-analysis

  时间线（本地时间）：09:30 插件融合并生成 T0 队列 → 10:00 本任务唤起 agent 做簇分析。
  故意留 30 分钟间隔，让「融合 + 队列生成」先跑完。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sparkos.intel-analysis</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PLUGIN_ROOT__/launch/sparkos-intel-analysis.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SPARKOS_PLUGIN_ROOT</key><string>__PLUGIN_ROOT__</string>
    <key>SPARKOS_VAULT_ROOT</key><string>__VAULT_ROOT__</string>
    <key>DSH_CLI</key><string>__DSH_CLI__</string>
    <key>DSH_HOME</key><string>__DSH_HOME__</string>
    <key>SPARKOS_KNOWLEDGE_ROOT</key><string>__KNOWLEDGE_ROOT__</string>
    <key>SPARKOS_CONTENTOS_ROOT</key><string>__CONTENTOS_ROOT__</string>
    <key>SPARKOS_MEDIA_OS_ROOT</key><string>__MEDIA_OS_ROOT__</string>
    <key>SPARKOS_DAILY_BRIEF_DIR</key><string>__DAILY_BRIEF_DIR__</string>
    <key>SPARKOS_PERF_DIR</key><string>__PERF_DIR__</string>
    <key>SPARKOS_RUNTIME_DISTILL_QUEUE</key><string>__DISTILL_QUEUE__</string>
    <key>SPARKOS_RUNTIME_EVENTS</key><string>__EVENTS__</string>
    <key>SPARKOS_ALPHA_ARCHIVE</key><string>__ALPHA_ARCHIVE__</string>
    <key>SPARKOS_HN_ARCHIVE</key><string>__HN_ARCHIVE__</string>
    <key>SPARKOS_HERMES_ARCHIVE</key><string>__HERMES_ARCHIVE__</string>
    <key>SPARKOS_BAICAOTANG_ARCHIVE</key><string>__BAICAOTANG_ARCHIVE__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>__VAULT_ROOT__/system/intel-analysis.log</string>
  <key>StandardErrorPath</key><string>__VAULT_ROOT__/system/intel-analysis.log</string>
</dict>
</plist>
